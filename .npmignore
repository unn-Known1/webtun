# npm tarball excludes — runtime files only (plus npm's always-included
# package.json, README.md, LICENSE and the main entry). GitHub Pages docs
# assets (robots.txt, sitemap.xml, .nojekyll) stay out of the tarball.
.opencode/
.github/
nodemon.json
.gitignore
electron/
electron-builder.yml
setup.sh
install.sh
stop.sh
scripts/
.env
*.log
*.tgz
webtun.pid
.tunnels.json
tunnel-url.txt
.nojekyll
robots.txt
sitemap.xml
/dist/
/release/
/*.md
