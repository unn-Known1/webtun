# WebTun example config — copy to .env and edit. Never commit a real .env.
# Empty PIN= means no auth (NOT recommended if exposed to the internet).
# NOTE: values run to end-of-line — the server does not strip trailing
# ` # comments`, so `PIN=abc # my pin` loads the PIN as `abc # my pin`.
# Keep values comment-free (quoting with "..." is allowed and stripped once).
PORT=3000
HOST=
PIN=
SHELL=
WORKSPACE_ROOT=
# Set to "false" to confine the File API to WORKSPACE_ROOT (default "true"
# means full filesystem access; terminal shells are always unconfined).
ALLOW_FULL_FS=
# Where runtime state lives (.env, history, tunnels) for global/npx installs.
# Defaults to ~/.config/webtun; repo checkouts keep state beside server.js.
XDG_CONFIG_HOME=
# Set TRUST_PROXY=true only when behind a TLS-terminating reverse proxy.
TRUST_PROXY=false
# Windows only: override shell (default PowerShell; e.g. /usr/bin/bash for Git Bash).
WEBTUN_SHELL=
# Comma-separated extra WebSocket origins for reverse-proxy/custom hostnames.
ALLOWED_ORIGINS=
# Comma-separated allow-list for app preview targets; unset = any port except WebTun's own.
PREVIEW_PORTS=
# Optional sha256 pin for the auto-downloaded cloudflared binary (refuses install on mismatch).
CLOUDFLARED_SHA256=
# JSON body limits (default 2 MB everywhere, 12 MB for POST /api/files/write).
# Format: number + b|kb|mb (e.g. 5mb). Invalid values fall back to defaults.
JSON_LIMIT=
JSON_LIMIT_LARGE=
