{
  "name": "webtun",
  "version": "2.0.5",
  "description": "Self-hosted web terminal with Cloudflare Tunnel, file explorer, and PWA support",
  "author": {
    "name": "Gaurang Patel",
    "email": "ptelgm.yt@gmail.com"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "main": "electron/main.js",
  "bin": {
    "webtun": "bin/webtun.js"
  },
  "files": [
    "bin/",
    "server.js",
    "lib/",
    "public/",
    "postinstall.js"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "electron": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "postinstall": "node postinstall.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/unn-Known1/webtun.git"
  },
  "homepage": "https://github.com/unn-Known1/webtun#readme",
  "bugs": {
    "url": "https://github.com/unn-Known1/webtun/issues"
  },
  "keywords": [
    "terminal",
    "web-terminal",
    "ssh",
    "ssh-alternative",
    "remote-access",
    "remote-terminal",
    "cloudflare",
    "tunnel",
    "file-manager",
    "pwa",
    "self-hosted",
    "homelab",
    "electron",
    "xterm",
    "git",
    "devtools"
  ],
  "build": {
    "appId": "com.webtun.app",
    "productName": "WebTun",
    "asar": true,
    "files": [
      "electron/**/*",
      "server.js",
      "lib/**/*",
      "public/**/*",
      "LICENSE",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon-512.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/icon-512.png",
      "category": "Utility"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/icon-512.png",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "express": "^4.22.2",
    "multer": "^2.0.0",
    "node-pty": "^1.0.0",
    "ws": "^8.21.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.16.0",
    "nodemon": "^3.1.14"
  },
  "overrides": {
    "@electron/asar": "^4.3.0",
    "@electron/get": "^5.1.0",
    "array-flatten": "npm:@socketregistry/array-flatten@^1",
    "define-properties": "npm:@socketregistry/define-properties@^1",
    "es-define-property": "npm:@socketregistry/es-define-property@^1",
    "es-set-tostringtag": "npm:@socketregistry/es-set-tostringtag@^1",
    "form-data": "4.0.6",
    "function-bind": "npm:@socketregistry/function-bind@^1",
    "globalthis": "npm:@socketregistry/globalthis@^1",
    "gopd": "npm:@socketregistry/gopd@^1",
    "has-property-descriptors": "npm:@socketregistry/has-property-descriptors@^1",
    "has-symbols": "npm:@socketregistry/has-symbols@^1",
    "has-tostringtag": "npm:@socketregistry/has-tostringtag@^1",
    "hasown": "npm:@socketregistry/hasown@^1",
    "isarray": "npm:@socketregistry/isarray@^1",
    "ms": "2.1.3",
    "object-keys": "npm:@socketregistry/object-keys@^1",
    "qs": "6.16.0",
    "safe-buffer": "npm:@socketregistry/safe-buffer@^1",
    "safer-buffer": "npm:@socketregistry/safer-buffer@^1",
    "side-channel": "npm:@socketregistry/side-channel@^1",
    "typedarray": "npm:@socketregistry/typedarray@^1",
    "ws": "^8.21.0"
  },
  "resolutions": {
    "@electron/asar": "^4.3.0",
    "@electron/get": "^5.1.0",
    "array-flatten": "npm:@socketregistry/array-flatten@^1",
    "define-properties": "npm:@socketregistry/define-properties@^1",
    "es-define-property": "npm:@socketregistry/es-define-property@^1",
    "es-set-tostringtag": "npm:@socketregistry/es-set-tostringtag@^1",
    "function-bind": "npm:@socketregistry/function-bind@^1",
    "globalthis": "npm:@socketregistry/globalthis@^1",
    "gopd": "npm:@socketregistry/gopd@^1",
    "has-property-descriptors": "npm:@socketregistry/has-property-descriptors@^1",
    "has-symbols": "npm:@socketregistry/has-symbols@^1",
    "has-tostringtag": "npm:@socketregistry/has-tostringtag@^1",
    "hasown": "npm:@socketregistry/hasown@^1",
    "isarray": "npm:@socketregistry/isarray@^1",
    "ms": "2.1.3",
    "object-keys": "npm:@socketregistry/object-keys@^1",
    "qs": "6.16.0",
    "safe-buffer": "npm:@socketregistry/safe-buffer@^1",
    "safer-buffer": "npm:@socketregistry/safer-buffer@^1",
    "side-channel": "npm:@socketregistry/side-channel@^1",
    "typedarray": "npm:@socketregistry/typedarray@^1",
    "ws": "^8.21.0"
  },
  "allowScripts": {
    "node-pty": true
  }
}
